{
  "name": "@kitty-crow/app-kittycrow-dev",
  "version": "1.0.5",
  "private": true,
  "type": "module",
  "description": "Static app index for app.kittycrow.dev.",
  "author": "Kitty Crow <kitty@kittycrow.dev> (https://kittycrow.dev)",
  "license": "MIT",
  "scripts": {
    "check": "bun run site:check && bun run site:test",
    "site:check": "bunx tsc -p site/tsconfig.json --noEmit && bunx tsc -p site/tsconfig.bun.json --noEmit",
    "site:build": "bun run site/build.ts",
    "site:test": "bun test site/tests",
    "site:ci": "bun run site:check && bun run site:build && bun run site:test"
  },
  "dependencies": {
    "@kittycrypto/website": "file:vendor/website",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3"
  },
  "engines": {
    "bun": ">=1.3.14"
  }
}
